{
    "$schema": "./node_modules/fallow/schema.json",
    // docs/reference/taobao-ui/**：本机参考物料（淘宝 UI 抓取产物 + 脚本 capture.mjs），不是产品代码，
    // 已进 .gitignore 不入库；这里再排除一次，是因为 fallow 扫的是工作区磁盘（不看 git），
    // 不排会让本地 `pnpm fallow` 去分析这些文件（glob 必须带 /** 才会命中目录内的文件）。
    "ignorePatterns": ["apps/server", "docs/reference/taobao-ui/**"],
    "plugins": ["perf/fallow-plugin.jsonc"],
    // 死代码判定的豁免（ignoreFindings 只覆盖死代码，health 与 dupes 要各自排）：
    //   packages/api/src/sdk/**  —— 契约生成物
    //   ui-web 的 reui/**        —— 第三方 vendored 组件。它已由 RegionPicker / 运费模板多选
    //     经 ui-web 的 barrel 引用（fallow 能追踪到），但目录内的其余文件（分栏、页脚、i18n
    //     等子模块）只被同目录内部引用，从入口看仍是不可达——那是组件库按模块拆分的常态，
    //     不是死代码。逐个文件挂 fallow-ignore-file 反而会把 vendored 文件改得面目全非。
    "ignoreFindings": ["packages/api/src/sdk/**", "packages/ui-web/src/components/reui/**"],
    // `oxc-transform-react`：构建期由 vite 插件按名字加载，代码里没有 import。
    // 后三个是 oxlint 的 JS 插件（根 vite.config.ts 的 lint.jsPlugins 里以字符串 specifier 注册），
    // 同理：加载方是 oxlint 进程而不是我们的源码，静态图看不见这种引用。
    // `squawk-cli`：只被 scripts/db-migrations-lint.mjs 以 `pnpm exec squawk` 的字符串命令调用，
    // 没有 import 边；它提供的二进制正是 db:migrations:lint 门禁的执行体。这条是存量 finding，
    // 改动 package.json 时会重新落到 diff 上，所以按同一口径显式登记，不每次改动都复现一遍。
    "ignoreDependencies": [
        "oxc-transform-react",
        "@shadcn/lint",
        "@tanstack/eslint-plugin-query",
        "@tanstack/eslint-plugin-router",
        "squawk-cli",
        // 第四个 oxlint JS 插件，同类漏登记：它以 `{ name, specifier }` 对象形式注册在
        // packages/config/oxlint.config.ts 的 jsPlugins 里，加载方是 oxlint 进程。
        // （fallow 3.32 起开始报它，3.30 没报——同一份代码，判据变严了。）
        "oxlint-plugin-react-doctor",
        // 跨域 barrel 约束那一族，同样只有「运行时的字符串引用」：
        //   · eslint-plugin-boundaries —— jsPlugins 里的字符串 specifier；
        //   · eslint-import-resolver-typescript —— 连 specifier 都没有，它由上面那个插件按
        //     settings 里的键名 `import/resolver.typescript` 在运行时 require（解析别名用的）。
        // 两个都没有 import 边，但删掉任何一个都会让「跨域只许 barrel」静默失效——所以登记。
        "eslint-plugin-boundaries",
        "eslint-import-resolver-typescript",
        // `yaml`：被 scripts/i18n-config.mjs 与 scripts/routing-drift.mjs 静态 import，而那两个是
        // CI 门禁（i18n:drift / routing:drift）的执行体，不是 shipped 产品的运行时依赖——所以它住
        // devDependencies 是对的。fallow 的 `--production` 视角把 scripts/*.mjs 也算生产，于是报
        // 「dev dependency in production」。改动 package.json 时这条会重新落到 diff 上，按 squawk-cli
        // 同一口径显式登记，不每次改动都复现一遍。
        "yaml"
    ],
    // 单测从模块边界测内部 helper，故「仅本文件内被引用」的导出不算死代码；彻底无引用仍会报
    "ignoreExportsUsedInFile": true,
    // 「只给测试用的导出」在 `--production` 视角下会被判成死代码：那个视角把 test/spec/dev
    // 整批从发现范围里剔除，导出就真的没有生产消费者了（本地 `fallow dead-code` 看得到，
    // 因为它把测试文件也当入口）。
    // DETAIL_FIRST_CODES 就是这种：迁移期例外清单，只有 error-keys.test.ts / notify.test.tsx
    // 拿它核「这两条码还没参数化」，生产代码一律走 errorKeyFor()。
    "ignoreExports": [
        {
            "file": "packages/app-kit/src/i18n/error-keys.ts",
            "exports": ["DETAIL_FIRST_CODES"]
        }
    ],
    // 根 vite.config.ts 是前端工具链配置的唯一入口（lint/fmt 块从这里被消费），
    // 把它记成手动入口，它 import 的 packages/config/{oxlint,oxfmt}.config.ts 才算可达。
    // 迁移前不用写：那时 `lint:web` 脚本里有 `--config packages/config/oxlint.config.ts`，
    // fallow 从 package.json 脚本就能顺着认到它；换成 `vp lint` 之后那条路径消失了，
    // 两个配置文件会被判成死代码（实测 2 unused files）。
    // `contracts/error-codes.mjs` 同一类：它由 codegen 以**运行时算出来的路径**动态 import
    // （`await import(\`file://${REGISTRY}\`)`），静态图上没有这条边，于是那份「唯一真相源」
    // 看起来像没人用的文件。它恰恰是全仓最不能死的文件——被 import 反而只是它的一种用法。
    // scripts 不是 workspace 包；独立 Vitest project 的 .mjs 测试需显式登记真实执行入口。
    "entry": [
        "packages/api/openapi-ts.config.ts",
        "vite.config.ts",
        "contracts/error-codes.mjs",
        // 同一类：`contracts/permissions.mjs` 也只被 permissions-codegen 以运行时算出的路径动态
        // import（`await import(\`file://${REGISTRY}\`)`），静态图没有这条边，那份「唯一真相源」
        // 会看起来像没人用的文件——恰恰是全仓最不能死的那类。
        "contracts/permissions.mjs",
        "scripts/*.test.mjs",
        "scripts/normalize-sdk.mjs",
        // perf 的 playwright globalSetup：e2e/perf.config.ts 里写的是字符串
        // `globalSetup: "./performance/setup.ts"`，静态图上没有这条边。fallow 会跟随
        // **playwright.config.ts** 的 globalSetup，但 perf.config.ts 不是它认识的那个文件名，
        // 于是只被当成普通 config 插件入口，这个 setup 就成了"没人用"。3.32 起开始报
        // （3.30 没报），按同一口径显式登记——它本来就是真实执行入口。
        "e2e/performance/setup.ts"
    ],
    // 生成物与造数脚本不进重构/重复的判据：ignoreFindings 只覆盖死代码，health 与 dupes 要各自排。
    // 第三方 vendored 组件（ui-web 的 reui/**）同理：它们带来成百的复杂度与
    // 重复克隆，但那些代码不是我们写的，也不打算重构——重构 vendored 代码会彻底断掉与上游的
    // diff 能力。它们仍被 tsc（strict + noUncheckedIndexedAccess）与 lint 的项目级规则检查。
    "health": {
        // 钉默认阈值：cc 20 / cognitive 15 / CRAP 42 / 单元 60（全库 avg cc1.5 p90 3，cc20 仅命中 1 函数）。
        // CRAP = cc²·(1-cov)³ + cc，未覆盖退化成 cc²+cc，与 cc 强耦合——它是「复杂**且**没单测」的附加闸，
        // 真正的复杂度安全网是 cc 与 cognitive。渲染组件的 cognitive/CRAP 误伤见下方 thresholdOverrides。
        "maxCyclomatic": 20,
        "maxCognitive": 15,
        "maxCrap": 42,
        "maxUnitSize": 60,
        // 渲染组件两处结构性误伤，用数值天花板放宽（仍可配、非二元 ignore）：
        //   cognitive——分支来自「有值才渲染」+ hooks 计数，是声明式 JSX 的结构特征，抬到 25。
        //   CRAP——惩罚「复杂且没单测」，但组件的安全网是 e2e 不是 vitest，单测覆盖率对它是错误
        //     代理；关掉后真正该重构的大组件仍被 maxUnitSize 60 / cc 20 揪住，不藏问题。
        // .ts 逻辑模块维持基线（cognitive 15 / CRAP 42），复杂无测的纯逻辑函数照拦。
        "thresholdOverrides": [
            {
                "files": ["apps/*/src/**/*.tsx", "packages/ui-web/src/**/*.tsx"],
                "maxCognitive": 25,
                "maxCrap": 999
            },
            // perf/**：LHCI 的进程内插件（gatherer / audit）与场景定义，不进任何产物，也不是
            // vitest 的覆盖对象——单测在 scripts/lighthouse-ci.test.mjs，端到端由 CI 的 lighthouse
            // job 跑。Istanbul 覆盖率看不见它们，CRAP 在这里退化成 cc²+cc 的纯 cc 代理，是错误信号
            // （cc 6 就顶到 42 的上限）。关 CRAP，cc 20 / cognitive 15 / unitSize 60 照常拦。
            {
                "files": ["perf/**"],
                "maxCrap": 999,
                "reason": "LHCI 进程内插件，覆盖率由 lighthouse job 与 scripts 单测保证，CRAP 是错误代理"
            }
        ],
        "ignore": [
            "packages/api/src/sdk/**",
            "**/*.gen.ts",
            "scripts/**",
            "packages/ui-web/src/components/reui/**"
        ]
    },
    "duplicates": {
        "ignore": [
            "packages/api/src/sdk/**",
            "**/*.gen.ts",
            "scripts/**",
            "packages/ui-web/src/components/reui/**"
        ]
    },
    "boundaries": {
        "zones": [
            // 横切资源先匹配：locales/index.ts 不能被下面的通用 domain barrel 模式抢走。
            { "name": "shared", "patterns": ["apps/*/src/shared/**", "apps/*/src/locales/**"] },
            // barrel 单列一 zone 仍是必要的：它是 `routes`/`shell` 唯一被允许碰的域内文件，
            // 也是规则表里 domain-api 那个 allow 项的指代对象。但**它不再承担跨域约束**（见上）。
            { "name": "domain-api", "patterns": ["apps/*/src/*/index.ts"] },
            { "name": "routes", "patterns": ["apps/*/src/routes/**"] },
            { "name": "shell", "patterns": ["apps/*/src/app/**", "apps/*/src/layout/**"] },
            // `locales/**` 与 shared 同级看待：它是跨域横切资源（每个域的组件都要 `useT` 取文案），
            // 单独划一个 zone 会让「域 → locales」这条必然存在的边变成 boundary violation。
            {
                "name": "kit",
                "patterns": [
                    "packages/common/**",
                    "packages/i18n/**",
                    "packages/monitoring/**",
                    "packages/client/**",
                    "packages/app-kit/**",
                    "packages/ui-web/**"
                ]
            },
            {
                "name": "domain",
                "patterns": ["apps/*/src/*/**"]
            }
        ],
        "rules": [
            { "from": "routes", "allow": ["domain-api", "domain", "shared", "kit", "shell"] },
            { "from": "shell", "allow": ["domain-api", "domain", "shared", "kit", "routes"] },
            // `domain` 是 autoDiscover 出来的 `domain/<目录名>` 的前缀（allow 项按前缀匹配），
            // 所以这一项 = 域内互通（跨域 barrel 导入的源模块落在对方域里，见上方长注释）。
            // 真正拦「跨域直插内部文件」的是 oxlint，不是这里。
            { "from": "domain", "allow": ["domain", "domain-api", "shared", "kit"] },
            { "from": "shared", "allow": ["shared", "kit"] },
            { "from": "kit", "allow": ["kit"] }
        ]
    }
}
