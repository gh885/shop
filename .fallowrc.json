{
    "$schema": "./node_modules/fallow/schema.json",
    "ignorePatterns": ["apps/server"],
    // 死代码判定的豁免（ignoreFindings 只覆盖死代码，health 与 dupes 要各自排）：
    //   packages/api/src/sdk/**  —— 契约生成物
    //   ui-web 的 reui/**        —— 第三方 vendored 组件。它已由 RegionPicker / 运费模板多选
    //     经 ui-web 的 barrel 引用（fallow 能追踪到），但目录内的其余文件（分栏、页脚、i18n
    //     等子模块）只被同目录内部引用，从入口看仍是不可达——那是组件库按模块拆分的常态，
    //     不是死代码。逐个文件挂 fallow-ignore-file 反而会把 vendored 文件改得面目全非。
    "ignoreFindings": ["packages/api/src/sdk/**", "packages/ui-web/src/components/reui/**"],
    // `oxc-transform-react`：构建期由 vite 插件按名字加载，代码里没有 import。
    // 后三个是 oxlint 的 JS 插件（根 vite.config.ts 的 lint.jsPlugins 里以字符串 specifier 注册），
    // 同理：加载方是 oxlint 进程而不是我们的源码，静态图看不见这种引用。
    "ignoreDependencies": [
        "oxc-transform-react",
        "@shadcn/lint",
        "@tanstack/eslint-plugin-query",
        "@tanstack/eslint-plugin-router"
    ],
    // 单测从模块边界测内部 helper，故「仅本文件内被引用」的导出不算死代码；彻底无引用仍会报
    "ignoreExportsUsedInFile": true,
    // 「只给测试用的导出」在 `--production` 视角下会被判成死代码：那个视角把 test/spec/dev
    // 整批从发现范围里剔除，导出就真的没有生产消费者了（本地 `fallow dead-code` 看得到，
    // 因为它把测试文件也当入口）。
    // DETAIL_FIRST_CODES 就是这种：迁移期例外清单，只有 error-keys.test.ts / notify.test.tsx
    // 拿它核「这两条码还没参数化」，生产代码一律走 errorKeyFor()。
    "ignoreExports": [
        {
            "file": "packages/app-kit/src/i18n/error-keys.ts",
            "exports": ["DETAIL_FIRST_CODES"]
        }
    ],
    // 根 vite.config.ts 是前端工具链配置的唯一入口（lint/fmt 块从这里被消费），
    // 把它记成手动入口，它 import 的 packages/config/{oxlint,oxfmt}.config.ts 才算可达。
    // 迁移前不用写：那时 `lint:web` 脚本里有 `--config packages/config/oxlint.config.ts`，
    // fallow 从 package.json 脚本就能顺着认到它；换成 `vp lint` 之后那条路径消失了，
    // 两个配置文件会被判成死代码（实测 2 unused files）。
    // `openapi/error-codes.mjs` 同一类：它由 codegen 以**运行时算出来的路径**动态 import
    // （`await import(\`file://${REGISTRY}\`)`），静态图上没有这条边，于是那份「唯一真相源」
    // 看起来像没人用的文件。它恰恰是全仓最不能死的文件——被 import 反而只是它的一种用法。
    // scripts 不是 workspace 包；独立 Vitest project 的 .mjs 测试需显式登记真实执行入口。
    "entry": [
        "packages/api/openapi-ts.config.ts",
        "vite.config.ts",
        "openapi/error-codes.mjs",
        "scripts/*.test.mjs"
    ],
    // 生成物与造数脚本不进重构/重复的判据：ignoreFindings 只覆盖死代码，health 与 dupes 要各自排。
    // 第三方 vendored 组件（ui-web 的 reui/**）同理：它们带来成百的复杂度与
    // 重复克隆，但那些代码不是我们写的，也不打算重构——重构 vendored 代码会彻底断掉与上游的
    // diff 能力。它们仍被 tsc（strict + noUncheckedIndexedAccess）与 lint 的项目级规则检查。
    "health": {
        // 钉默认阈值：cc 20 / cognitive 15 / CRAP 42 / 单元 60（全库 avg cc1.5 p90 3，cc20 仅命中 1 函数）。
        // CRAP = cc²·(1-cov)³ + cc，未覆盖退化成 cc²+cc，与 cc 强耦合——它是「复杂**且**没单测」的附加闸，
        // 真正的复杂度安全网是 cc 与 cognitive。渲染组件的 cognitive/CRAP 误伤见下方 thresholdOverrides。
        "maxCyclomatic": 20,
        "maxCognitive": 15,
        "maxCrap": 42,
        "maxUnitSize": 60,
        // 渲染组件两处结构性误伤，用数值天花板放宽（仍可配、非二元 ignore）：
        //   cognitive——分支来自「有值才渲染」+ hooks 计数，是声明式 JSX 的结构特征，抬到 25。
        //   CRAP——惩罚「复杂且没单测」，但组件的安全网是 e2e 不是 vitest，单测覆盖率对它是错误
        //     代理；关掉后真正该重构的大组件仍被 maxUnitSize 60 / cc 20 揪住，不藏问题。
        // .ts 逻辑模块维持基线（cognitive 15 / CRAP 42），复杂无测的纯逻辑函数照拦。
        "thresholdOverrides": [
            {
                "files": ["apps/*/src/**/*.tsx", "packages/ui-web/src/**/*.tsx"],
                "maxCognitive": 25,
                "maxCrap": 999
            }
        ],
        "ignore": [
            "packages/api/src/sdk/**",
            "**/*.gen.ts",
            "scripts/**",
            "packages/ui-web/src/components/reui/**"
        ]
    },
    "duplicates": {
        "ignore": [
            "packages/api/src/sdk/**",
            "**/*.gen.ts",
            "scripts/**",
            "packages/ui-web/src/components/reui/**"
        ]
    },
    // frontend.md:17 的依赖方向：routes → domain → shared。跨域只能取对方 index.ts，
    // 所以 barrel 自成一个 zone；直插对方 queries.ts / model.ts 会成 boundary-violation
    "boundaries": {
        "zones": [
            // 横切资源先匹配：locales/index.ts 不能被下面的通用 domain barrel 模式抢走。
            { "name": "shared", "patterns": ["apps/*/src/shared/**", "apps/*/src/locales/**"] },
            { "name": "domain-api", "patterns": ["apps/*/src/*/index.ts"] },
            { "name": "routes", "patterns": ["apps/*/src/routes/**"] },
            { "name": "shell", "patterns": ["apps/*/src/app/**", "apps/*/src/layout/**"] },
            // `locales/**` 与 shared 同级看待：它是跨域横切资源（每个域的组件都要 `useT` 取文案），
            // 把它当独立 autoDiscover zone 会让「域 → locales」这条必然存在的边变成 boundary violation。
            {
                "name": "kit",
                "patterns": ["packages/common/**", "packages/app-kit/**", "packages/ui-web/**"]
            },
            {
                "name": "domain",
                "autoDiscover": ["apps/web/src", "apps/seller/src", "apps/admin/src"]
            }
        ],
        "rules": [
            { "from": "routes", "allow": ["domain-api", "domain", "shared", "kit", "shell"] },
            { "from": "shell", "allow": ["domain-api", "domain", "shared", "kit", "routes"] },
            { "from": "domain", "allow": ["domain-api", "shared", "kit"] },
            { "from": "shared", "allow": ["shared", "kit"] },
            { "from": "kit", "allow": ["kit"] }
        ]
    }
}
