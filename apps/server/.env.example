# shop-server 生产环境变量清单
#
# 用法：复制为 .env（已被根 .gitignore 忽略）供 docker-compose/--env-file/systemd EnvironmentFile 消费；
# 或由部署平台（K8s Secret / 宝塔 / 手动 export）注入。Spring 环境变量优先级高于 application.yml。
# 本地开发不需要任何变量——默认 profile 自带 dev 默认值（本地库/临时 JWT 密钥/固定验证码 666666）。

# ---- 构建版本（必填，由发布流程注入 git sha，如 git rev-parse --short HEAD）----
# 写进每行日志的 version 字段；前端上报用同一个值（frontend-monitoring.md 契约 4），按它关联「哪次发布」
SHOP_VERSION=

# ---- 数据库（必填）----
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:15432/shop
SPRING_DATASOURCE_USERNAME=shop
SPRING_DATASOURCE_PASSWORD=change-me

# ---- Redis（host 必填；无密码实例保持空并确认网络隔离）----
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ---- 安全 pepper（必填，openssl rand -hex 32 生成）----
# 验证码 / refresh token 落 Redis 前的 HMAC 密钥；泄露 = 可离线伪造凭证。轮换 = 全员重新登录。
SHOP_SECURITY_PEPPER=openssl-rand-hex-32

# ---- JWT ES256 密钥对（必填，base64 PKCS#8 私钥 + X.509 公钥）----
# 生成私钥：openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# 导出公钥：openssl ec -in key.pem -pubout -outform DER | base64 -w0
# 固定密钥对的意义：重启后已签发 token 不失效；多实例共享验签能力。
SHOP_JWT_PRIVATE_KEY=
SHOP_JWT_PUBLIC_KEY=

# ---- 遥测链路（本机开发不用管：默认开着 + localhost:9092，用 deploy/kafka.compose.yml 起 broker）----
# 一条链路四段：接收端（POST /api/rum/events）→ Kafka → 加工链（脱敏 / 路径归一）→ 落点（指标 + 日志）。
#
# 总开关。**生产默认 false**（application-prod.yml 里写死的默认值），因为生产没有 broker——
# 那台 2C/1.6G 主机实测可用 782M / swap 已用 490M，塞不下一个 JVM（判断与 ADR 0005 同源）。
# 不关的症状最差：浏览器照发、接收端照回 204、投递指向不存在的 localhost:9092，
# 于是页面毫无感觉而 publish.failed 一路涨——一条没人看却又像在工作的曲线。
# 关掉之后门口就拦下，一个假信号都不产生；上报照收照回 204，只是不留。
#
# 有了 broker 之后：填它的地址 + SHOP_RUM_ENABLED=true（这一个开关同时管接收端与消费端）重启即可。
# 前端一个字都不用改——上报本来就没停过，之前只是被门口丢掉了。
# SHOP_RUM_ENABLED=true
#
# Kafka 地址。只在 SHOP_RUM_ENABLED=true 时有意义
# SHOP_KAFKA_BOOTSTRAP=localhost:9092

# ---- 反向代理（按部署拓扑）----
# 仅当部署在会覆写 X-Forwarded-For 的可信反代之后才设 true，否则 IP 限流可被伪造头绕过
SHOP_WEB_TRUST_FORWARDED_FOR=false

# ---- CORS 允许来源（必填，逗号分隔的完整来源，含协议与端口）----
# 无默认值，漏配即启动失败——好过带着 localhost 白名单上线、换域名后全站跨域失败。
# 前后端同源部署（反代同一域名）时 CORS 不参与，填站点自身域名即可。
SHOP_WEB_CORS_ALLOWED_ORIGINS=https://shop.example.com,https://seller.example.com

# ---- 短信频控（可选）----
# 单 IP 每日可发验证码的不同手机号数上限，默认 30。CGNAT / 公司出口 / 校园网下大量真实用户
# 共享同一出口 IP，按实际出口 IP 分布调整；调低会误伤正常注册。
# SHOP_AUTH_SMS_IP_DISTINCT_PHONES_MAX=30

# ---- 短信通道（接入真实 SmsChannel 实现前不要上线生产）----
# dev 值 = 验证码打日志 + 固定码 666666 后门，生产禁止继承
SHOP_AUTH_SMS_CHANNEL=

# ---- refresh cookie 共享父域（可选，用于买/卖家跨子域单点登录）----
# 设成与前端子域一致的父域（如 .example.com），web(买家) 与 seller(卖家) 共用 refresh cookie：
# 登录一处另一处自动登录（淘宝千牛式共享会话）。留空 = 各站独立会话（不自动登录）。
# 注意：admin 走独立 staff 账号体系，与 C 端隔离，不在此列。
SHOP_AUTH_REFRESH_COOKIE_DOMAIN=

# ---- 日志文件路径（可选，默认 /var/log/shop/shop-server.log）----
# SHOP_LOG_FILE=/var/log/shop/shop-server.log

# ---- 应用内对账作业（可选，默认每天 03:15；Spring cron 六段式）----
# SHOP_RECONCILE_CRON=0 15 3 * * *

# ---- 七牛云对象存储（图片直传，选配）----
# 上传图片功能需要；不传图可不配。access-key/secret-key 在控制台「密钥管理」获取，泄露即账号裸奔。
# upload-host 按空间区域：华东 upload.qiniup.com / 华北 upload-z1.qiniup.com / 华南 upload-z2.qiniup.com
# public-base-url 用控制台绑定的 CDN/测试域名。本地开发放到 apps/server/.env（勿提交仓库）。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
# QINIU_BUCKET=xun-shop-370264
# QINIU_UPLOAD_HOST=upload-z1.qiniup.com
# QINIU_PUBLIC_BASE_URL=https://tkowmtfov.hb-bkt.clouddn.com
