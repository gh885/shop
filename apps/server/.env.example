# shop-server 生产环境变量清单
#
# 用法：复制为 .env（已被根 .gitignore 忽略）供 docker-compose/--env-file/systemd EnvironmentFile 消费；
# 或由部署平台（K8s Secret / 宝塔 / 手动 export）注入。Spring 环境变量优先级高于 application.yml。
# 本地开发不需要任何变量——默认 profile 自带 dev 默认值（本地库/临时 JWT 密钥/固定验证码 666666）。

# ---- 数据库（必填）----
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/shop
SPRING_DATASOURCE_USERNAME=shop
SPRING_DATASOURCE_PASSWORD=change-me

# ---- Redis（host 必填；无密码实例保持空并确认网络隔离）----
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ---- 安全 pepper（必填，openssl rand -hex 32 生成）----
# 验证码 / refresh token 落 Redis 前的 HMAC 密钥；泄露 = 可离线伪造凭证。轮换 = 全员重新登录。
SHOP_SECURITY_PEPPER=openssl-rand-hex-32

# ---- JWT ES256 密钥对（必填，base64 PKCS#8 私钥 + X.509 公钥）----
# 生成私钥：openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# 导出公钥：openssl ec -in key.pem -pubout -outform DER | base64 -w0
# 固定密钥对的意义：重启后已签发 token 不失效；多实例共享验签能力。
SHOP_JWT_PRIVATE_KEY=
SHOP_JWT_PUBLIC_KEY=

# ---- 反向代理（按部署拓扑）----
# 仅当部署在会覆写 X-Forwarded-For 的可信反代之后才设 true，否则 IP 限流可被伪造头绕过
SHOP_WEB_TRUST_FORWARDED_FOR=false

# ---- 短信通道（接入真实 SmsChannel 实现前不要上线生产）----
# dev 值 = 验证码打日志 + 固定码 666666 后门，生产禁止继承
SHOP_AUTH_SMS_CHANNEL=

# ---- 日志文件路径（可选，默认 /var/log/shop/shop-server.log）----
# SHOP_LOG_FILE=/var/log/shop/shop-server.log
