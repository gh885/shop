<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>com.shop</groupId>
	<artifactId>platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>shop-server</name>
	<description>Multi-shop e-commerce platform</description>

	<properties>
		<java.version>25</java.version>
		<!--
			安全补丁覆盖（osv-scanner 2026-10-06 报出，见 CI 的 security job）。
			这两个都是 Spring Boot **官方支持覆盖**的属性（spring-boot-dependencies 里就有同名 property），
			所以不算绕过 BOM——只是把 BOM 里的补丁版提前取过来。
			为什么不等 Spring Boot 升版：4.1.1 已是 4.1.x 最新补丁版（上游只有 4.2.0-M2 里程碑），
			而 Tomcat 那三条 CVSS 9.8/9.1 不该挂着等。
			上游一旦发布含这些修复的 4.1.x，删掉这两行即可（BOM 会接管）。
		-->
		<tomcat.version>11.0.25</tomcat.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
		<!-- Jackson 分两条线：jackson-bom 管 3.x（tools.jackson.*），jackson-2-bom 管 2.x
			（com.fasterxml.jackson.*）。两条都在 BOM 里，都受影响，所以两个都要顶。 -->
		<jackson-2-bom.version>2.21.7</jackson-2-bom.version>
		<spring-modulith.version>2.1.0</spring-modulith.version>
		<mybatis-plus.version>3.5.17</mybatis-plus.version>
		<spotless.version>2.44.4</spotless.version>
		<jjwt.version>0.12.6</jjwt.version>
		<qiniu.version>7.19.0</qiniu.version>
		<uuid-creator.version>6.1.1</uuid-creator.version>
		<archunit.version>1.4.2</archunit.version>
		<springdoc.version>3.1.0</springdoc.version>
		<!-- 静态分析：Error Prone 在编译期跑 NullAway（把 NPE 变成编译错误）。
		     版本钉在这里而不是锁死，是因为 Error Prone 跟 JDK 版本强绑定——
		     JDK 25 需要较新的 error_prone_core（见 .mvn/jvm.config 的 add-exports）。 -->
		<error-prone.version>2.50.0</error-prone.version>
		<nullaway.version>0.14.2</nullaway.version>
		<!-- 补盲静态分析：SpotBugs 走字节码（+ FindSecBugs 安全族），PMD 走源码 AST。
		     两者的 bug 族刻意只开 Error Prone 不覆盖的（复杂度 / 空 catch / 字节码模式 / 安全），
		     避免同一规则两个主人。当前接进构建先出存量报告，暂不绑 verify 阻塞门禁。 -->
		<spotbugs-plugin.version>4.8.3.1</spotbugs-plugin.version>
		<findsecbugs.version>1.13.0</findsecbugs.version>
		<pmd-plugin.version>3.26.0</pmd-plugin.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- 开发热重载：classpath 变化（mvn compile / IDE 构建）自动重启应用上下文；打 fat jar 时自动禁用 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<!-- 遥测接收端与加工之间的一层缓冲：接收端只投递、不等存储（rum 模块）。
			 **必须是 starter 而不是裸 spring-kafka**：Boot 4 把自动配置按技术拆成了独立模块，
			 4.1.1 的 spring-boot-autoconfigure 里 kafka 类是 0 个。只加 spring-kafka 能编译、
			 能跑单测（投递口被 mock 时用不到它），却在**真启动时**炸在
			 「No qualifying bean of type KafkaTemplate」上——一个只有真跑才看得见的坑。
			 starter 带来 spring.kafka.* 属性绑定、KafkaTemplate 与 KafkaAdmin（topic 声明）。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-kafka</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- Boot 4 把 RestClient 的自动装配拆出 starter-web：不带这一条就没有 RestClient.Builder bean，
			注入它的装配（KdniaoConfig）会让应用启动失败。顺带才有 http.client.requests 出站观测。 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>
		<!-- OpenAPI 契约：暴露 /v3/api-docs 与 Swagger UI，前端 openapi-typescript 据此生成类型 -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-core</artifactId>
		</dependency>

		<!-- 事件发布登记表（DB outbox）：发布与业务同事务落库，监听器崩溃/重启后自动补发，
			堵住 AFTER_COMMIT 异步消费「提交后进程挂了事件就丢」的窗口 -->
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-events-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-events-jackson</artifactId>
		</dependency>

		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot4-starter</artifactId>
			<version>${mybatis-plus.version}</version>
		</dependency>
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-jsqlparser</artifactId>
			<version>${mybatis-plus.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.f4b6a3</groupId>
			<artifactId>uuid-creator</artifactId>
			<version>${uuid-creator.version}</version>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- Auth -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- 七牛云对象存储（Kodo）：服务端签发上传凭证（presigned 直传），不在服务端中转文件流。
		     排除 okhttp：本仓库只用该 SDK 的本地签名 API（com.qiniu.util.Auth / StringMap），从不发起
		     HTTP——文件走浏览器直传，传输层在运行时不可达。而上游把 okhttp 钉死在 3.14.4（带 CVE、
		     无修复版），留着等于白背一个漏洞。okio 只由 okhttp 传递引入，排除后随之消失。
		     回归护栏：QiniuClientTest 用真实 Auth 签一张凭证，SDK 哪天把 okhttp 变成签名路径的
		     必需依赖就会红。 -->
		<dependency>
			<groupId>com.qiniu</groupId>
			<artifactId>qiniu-java-sdk</artifactId>
			<version>${qiniu.version}</version>
			<exclusions>
				<exclusion>
					<groupId>com.squareup.okhttp3</groupId>
					<artifactId>okhttp</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-runtime</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- 智能粘贴：中文收货地址解析（文本 → 姓名/电话/省市区/详细地址） -->
		<dependency>
			<groupId>com.github.alotuser</groupId>
			<artifactId>smart-parse-address</artifactId>
			<version>1.7.7</version>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<!-- 行政区划数据只存一份：packages/common/src/domain/data/regions.json（前端 loadRegionTree 的静态依赖）。
		     这里把它按 regions/ 路径复制进 classpath，供 RegionRegistry 的 ClassPathResource 读取。
		     曾长期存在第二份逐字节相同的副本且没有任何同步机制，两份的直筒子市规则各自实现，改一处漏一处。
		     方向选「Java 读前端包」而不是反过来：TS 的 import 必须落在自己包内，Maven 的资源路径可以跨目录。 -->
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>../../packages/common/src/domain/data</directory>
				<targetPath>regions</targetPath>
				<includes>
					<include>regions.json</include>
				</includes>
			</resource>
			<resource>
				<directory>../../contracts</directory>
				<includes>
					<include>i18n.config.yaml</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- JDK 23+ 默认关闭注解处理，Lombok 生成的符号（log/getPhone 等）全部“找不到符号”。
					    显式强开 proc=full，否则 Java 25 下 mvn compile/spring-boot:run 必挂（Java 25 测试产物里的 Lombok 符号缺失即此因）。 -->
					<proc>full</proc>
					<!-- Error Prone 必须 fork 出去的 javac 进程跑：它要加 add-exports 把 JDK 内部
					    com.sun.tools.javac.* 开放给自己，而这些导出参数用 -J 前缀透传给 fork 出的 javac 的 JVM。
					    （in-process 模式要把这些导出写进 .mvn/jvm.config，但本仓库环境里那份会让 mvn 整体起不来，
					    故走 fork。代价是每次编译多起一个 javac 进程，约 1 秒，可接受。） -->
					<fork>true</fork>
					<annotationProcessorPaths>
						<!-- Lombok 必须排第一：它改写内存里的 AST（生成 getter/Builder 等），
						    Error Prone 随后分析改写后的代码；顺序反了会出现“生成代码里的 NPE”漏报。 -->
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
						<!-- Error Prone 核心：接管 javac，作为插件宿主加载 NullAway。
						    本仓库用 Error Prone 官方推荐的 opt-in 模式：-XepDisableAllChecks 全关后逐条点名启用，
						    避免自带的上百条风格/正确性检查一次性淹没存量代码。
						    NullAway 直接 ERROR（把 NPE 变编译错误）；下面另把首批 correctness 精选（FallThrough /
						    ReturnValueIgnored / MissingCasesInEnumSwitch / OptionalNotPresent）定为 ERROR。
						    这 4 条经全量编译实测 0 存量命中，升 ERROR 零成本；今后新增命中优先改代码而非降规则。 -->
						<path>
							<groupId>com.google.errorprone</groupId>
							<artifactId>error_prone_core</artifactId>
							<version>${error-prone.version}</version>
						</path>
						<!-- NullAway：Error Prone 的插件，靠 ServiceLoader 被 core 发现，
						    所以只需在处理器路径上，不必显式 -Xplugin。 -->
						<path>
							<groupId>com.uber.nullaway</groupId>
							<artifactId>nullaway</artifactId>
							<version>${nullaway.version}</version>
						</path>
					</annotationProcessorPaths>
				<compilerArgs>
					<!-- JDK 21+ 必需：让类型注解写回 symbol 表，NullAway 才能读全注解。 -->
					<arg>-XDaddTypeAnnotationsToSymbol=true</arg>
					<!-- Error Prone 要求用 simple 编译策略（by-todo 默认策略它不支持，会直接拒载插件）。 -->
					<arg>-XDcompilePolicy=simple</arg>
					<!-- Error Prone 要求：在 FLOW 阶段发现错误即停，否则 INIT 策略它不支持、拒载插件。 -->
					<arg>--should-stop=ifError=FLOW</arg>
					<!-- 所有 -Xep* / -XepOpt* 必须拼进同一条 -Xplugin:ErrorProne 参数里；
					    拆成多条 arg 会被 javac 当成独立的 -X 开关而报错（invalid flag）。
					    另外：Windows + fork=true 下不能用多行 arg（Error Prone issue 4256）。
					    注意：绝不能加 should-stop=ifError=FLOW 这类参数——它会在 FLOW 阶段前停掉分析，
					    导致 Error Prone / NullAway 根本不跑（编译假绿）。 -->
					<arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:CustomContractAnnotations=org.springframework.lang.Contract -Xep:FallThrough:ERROR -Xep:ReturnValueIgnored:ERROR -Xep:MissingCasesInEnumSwitch:ERROR -Xep:OptionalNotPresent:ERROR</arg>
					<!-- 以下为 fork 出的 javac 进程开放 JDK 内部 API（JEP 396 强封装）：Error Prone
					    接管的正是这个进程里的 com.sun.tools.javac.*，不加这些会 NoClassDefFound / InaccessibleObject。
					    -J 前缀把参数透传给 javac 的 JVM（仅 fork 模式有效）。 -->
					<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
						<arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
						<arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<!-- 集成测试 *IT 在 verify 阶段跑（默认挑 *IT）。注意 *Test 不是「不碰库的快环」：
				MockMvc 那批（继承 WebControllerTestSupport）起全量上下文并连 shop_test，
				所以 mvn test 也要先有库；CI 门禁跑 mvn verify 才覆盖到 *IT -->
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<palantirJavaFormat>
							<version>2.74.0</version>
							</palantirJavaFormat>
						<importOrder />
						<removeUnusedImports />
					</java>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
