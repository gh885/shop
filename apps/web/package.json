{
    "name": "web",
    "private": true,
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "node ../../scripts/i18n-codegen.mjs && vp dev --port 3000",
        "build": "node ../../scripts/i18n-codegen.mjs && vp build",
        "preview": "vp preview",
        "start": "srvx serve --prod --dir=. --static=dist/client --entry=dist/server/server.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@shop/app-kit": "workspace:*",
        "@tailwindcss/vite": "catalog:",
        "@tanstack/react-devtools": "catalog:",
        "@tanstack/react-query": "catalog:",
        "@tanstack/react-query-devtools": "catalog:",
        "@tanstack/react-router": "catalog:",
        "@tanstack/react-router-devtools": "catalog:",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.168.60",
        "date-fns": "catalog:",
        "lucide-react": "catalog:",
        "motion": "^14.0.0",
        "react": "catalog:",
        "react-dom": "catalog:",
        "srvx": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@shop/api": "workspace:*",
        "@shop/common": "workspace:*",
        "@shop/config": "workspace:*",
        "@shop/test-utils": "workspace:*",
        "@shop/ui-web": "workspace:*",
        "@tanstack/devtools-vite": "catalog:",
        "@tanstack/router-cli": "catalog:",
        "@testing-library/react": "catalog:",
        "@testing-library/user-event": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "jsdom": "catalog:",
        "msw": "catalog:",
        "oxc-transform-react": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    }
}
