# 主机 ~/shop-app/.env 的模板。setup-host.sh 会按它生成真实文件（密钥现场生成、库口令从 ~/shop-infra/.env 抄），
# 真实文件 chmod 600、不进仓库。这里只列「主机常驻」的变量；每次发布变化的镜像引用在 images.env。
#
# 变量含义与取值口径以 apps/server/.env.example 为准，这里不重复解释。

# ---- 数据面（与 ~/shop-infra/.env 同值）----
SPRING_DATASOURCE_USERNAME=shop
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_PASSWORD=

# ---- 安全（setup-host.sh 用 openssl 现场生成）----
SHOP_SECURITY_PEPPER=
SHOP_JWT_PRIVATE_KEY=
SHOP_JWT_PUBLIC_KEY=

# ---- 站点来源：无域名阶段三端分别挂在 443 / 8443 / 9443（同一公网 IP）----
SHOP_WEB_CORS_ALLOWED_ORIGINS=https://__PUBLIC_IP__,https://__PUBLIC_IP__:8443,https://__PUBLIC_IP__:9443
# IP 没法设 cookie 父域，买家/卖家各自独立会话
SHOP_AUTH_REFRESH_COOKIE_DOMAIN=

# ---- 短信通道：demo 例外 ----
# 仓库里只有 DevSmsChannel（固定码 666666、验证码打日志），没有接短信服务商之前公开 demo 只能用它。
# 这是 docs/release/production-readiness.md 明确禁止的「生产继承 dev」——接了真实通道后必须改掉。
SHOP_AUTH_SMS_CHANNEL=dev

# ---- 七牛（选配；不配则传图接口报错，其余功能不受影响）----
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_UPLOAD_HOST=
QINIU_PUBLIC_BASE_URL=
