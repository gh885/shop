# 可观测性云端凭据清单（Grafana Cloud）
#
# 用法：复制为 .env.local（已被根 .gitignore 忽略）供本机联调使用；部署时主机侧另放一份。
# 六个值全部来自 Grafana Cloud stack 页面；两个 token 的值只在创建时显示一次，当场复制。
# 真实值禁止写进本文件或任何会提交的文件。

# ---- Prometheus（指标，Alloy 远程写）----
# stack → Prometheus → Details：Remote Write Endpoint / Username（数字 instance ID）
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USERNAME=

# ---- Loki（日志，Alloy 推送）----
# stack → Loki → Details：URL / User（数字 tenant ID）
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USERNAME=

# ---- Token ----
# 采集 token（scope：metrics:write + logs:write）——给 Alloy 用
GRAFANA_CLOUD_COLLECTOR_TOKEN=
# 管理 token（scope：metrics:read + logs:read + rules:read + rules:write）——小唯本机用，不进主机
GRAFANA_CLOUD_ADMIN_TOKEN=

# ---- Grafana 实例 API（看板/告警同步脚本用）----
# stack 的 Grafana 地址，形如 https://<你的slug>.grafana.net
GRAFANA_CLOUD_STACK_URL=
# Grafana 服务账号 token：Administration → Users and access → Service accounts，角色 Admin
GRAFANA_CLOUD_SA_TOKEN=
# 告警收件邮箱（同步脚本据此建 email contact point 并设为默认通知路由）。Grafana Cloud 只给 org 成员的邮箱发：填注册邮箱，或先把目标邮箱邀请进 org
GRAFANA_CLOUD_ALERT_EMAIL=
