{
    "apps": [
        {
            "name": "web",
            "port": 4173,
            "locale": "zh-Hans-CN",
            "pages": [
                {
                    "slug": "home",
                    "path": "/",
                    "selectors": ["main", "a[href*=\"/products/\"]"]
                },
                {
                    "slug": "product",
                    "path": "/products/{productId}",
                    "selectors": ["main", "h1"],
                    "text": "{productName}"
                },
                {
                    "slug": "welcome",
                    "path": "/welcome",
                    "selectors": ["h1", "a[href=\"#categories\"]", "a[href$=\"/sell\"]"]
                }
            ]
        },
        {
            "name": "seller",
            "port": 5000,
            "auth": {
                "login": "/api/seller/login",
                "cookie": "seller_refresh",
                "cookiePath": "/api/seller/refresh",
                "body": {
                    "loginName": "{account}",
                    "password": "{password}",
                    "deviceId": "perf-lab"
                }
            },
            "pages": [
                {
                    "slug": "seller-products",
                    "path": "/product/list",
                    "selectors": ["main", "table tbody tr"],
                    "text": "{productName}",
                    "api": "/api/seller/products"
                },
                {
                    "slug": "seller-orders",
                    "path": "/trade/order",
                    "selectors": ["main", "table tbody tr"],
                    "text": "{orderNo}",
                    "api": "/api/seller/orders"
                }
            ]
        },
        {
            "name": "admin",
            "port": 4000,
            "auth": {
                "login": "/api/staff/login",
                "cookie": "staff_refresh",
                "cookiePath": "/api/staff/refresh",
                "body": {
                    "loginName": "{account}",
                    "password": "{password}",
                    "deviceId": "perf-lab"
                }
            },
            "pages": [
                {
                    "slug": "admin-buyers",
                    "path": "/accounts/users",
                    "selectors": ["main", "table"],
                    "api": "/api/admin/buyers"
                },
                {
                    "slug": "admin-categories",
                    "path": "/categories",
                    "selectors": ["main"],
                    "api": "/api/admin/categories/tree"
                }
            ]
        }
    ]
}
