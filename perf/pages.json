{
    "apps": [
        {
            "name": "web",
            "port": 4173,
            "locale": "zh-Hans-CN",
            "pages": [
                {
                    "slug": "home",
                    "path": "/",
                    "selectors": ["main", "a[href^=\"/products/\"]"]
                },
                {
                    "slug": "product",
                    "path": "/products/{productId}",
                    "selectors": ["main", "h1"],
                    "text": "{productName}"
                },
                {
                    "slug": "welcome",
                    "path": "/welcome",
                    "selectors": ["h1", "a[href=\"#categories\"]", "a[href=\"/sell\"]"]
                }
            ]
        },
        {
            "name": "seller",
            "port": 5000,
            "auth": {
                "login": "/auth/login/password",
                "cookie": "refresh_token",
                "cookiePath": "/auth/refresh"
            },
            "pages": [
                {
                    "slug": "seller-products",
                    "path": "/product/list",
                    "selectors": ["main", "table tbody tr"],
                    "text": "{productName}",
                    "api": "/seller/products"
                },
                {
                    "slug": "seller-orders",
                    "path": "/trade/order",
                    "selectors": ["main", "table tbody tr"],
                    "text": "{orderNo}",
                    "api": "/seller/orders"
                }
            ]
        },
        {
            "name": "admin",
            "port": 4000,
            "auth": {
                "login": "/admin/auth/login",
                "cookie": "staff_refresh_token",
                "cookiePath": "/admin/auth/refresh"
            },
            "pages": [
                {
                    "slug": "admin-audits",
                    "path": "/audits",
                    "selectors": ["main", "table"],
                    "api": "/admin/audits"
                },
                {
                    "slug": "admin-shops",
                    "path": "/shops",
                    "selectors": ["main", "table"],
                    "text": "{shopName}",
                    "api": "/admin/shops",
                    "query": {
                        "keyword": "{shopName}"
                    }
                }
            ]
        }
    ]
}
