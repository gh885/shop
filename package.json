{
    "name": "shop",
    "version": "1.0.0",
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "dev": "pnpm dev:web && pnpm dev:server",
        "dev:web": "pnpm --filter web dev",
        "dev:admin": "pnpm --filter admin dev",
        "dev:seller": "pnpm --filter seller dev",
        "dev:server": "mvn -f apps/server/pom.xml spring-boot:run",
        "build": "pnpm build:web && pnpm build:server",
        "build:web": "pnpm --filter web build",
        "build:admin": "pnpm --filter admin build",
        "build:seller": "pnpm --filter seller build",
        "build:server": "mvn -f apps/server/pom.xml compile",
        "lint": "pnpm lint:web && pnpm lint:server ",
        "lint:web": "oxlint --config packages/config/oxlint.config.ts --fix .",
        "lint:server": "mvn -f apps/server/pom.xml compile",
        "format": "pnpm format:web && pnpm format:server",
        "format:web": "oxfmt --config packages/config/oxfmt.config.ts --write .",
        "format:server": "mvn -f apps/server/pom.xml spotless:apply",
        "typecheck": "pnpm --filter web exec tsc --noEmit && pnpm --filter admin exec tsc --noEmit && pnpm --filter seller exec tsc --noEmit",
        "gen:sdk": "curl -sf -m 10 http://localhost:8080/v3/api-docs -o openapi/api-docs.json && pnpm --filter @shop/api exec openapi-ts"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "lefthook": "^2.1.10",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.75.0",
        "oxlint-tailwindcss": "^1.5.0",
        "typescript": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.17.0",
            "onFail": "download"
        }
    }
}
