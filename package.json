{
    "name": "shop",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "type": "module",
    "scripts": {
        "dev": "concurrently -n web,server -c cyan,green \"pnpm --filter web dev\" \"pnpm dev:server\"",
        "dev:server": "concurrently -k -s first -n db,srv -c yellow,green \"node scripts/ensure-datastore.mjs --hold\" \"mvn -f apps/server/pom.xml spring-boot:run\"",
        "guard": "node scripts/tunnel-guard-task.mjs",
        "db:up": "node scripts/ensure-datastore.mjs",
        "db:down": "node scripts/ensure-datastore.mjs --down",
        "db:status": "node scripts/db-status.mjs",
        "obs": "node scripts/obs-stack.mjs",
        "obs:cloud:sync": "node scripts/obs-cloud-sync.mjs",
        "health:scan": "node scripts/ops-health-scan.mjs",
        "secret:scan": "node scripts/secret-scan.mjs",
        "seed:demo": "node scripts/seed-demo.mjs",
        "build": "pnpm --filter web build && pnpm build:server",
        "build:server": "mvn -f apps/server/pom.xml compile",
        "lint": "pnpm lint:web && pnpm build:server",
        "lint:web": "vp lint --type-aware .",
        "lint:web:fix": "vp lint --type-aware --fix . && pnpm typecheck",
        "format": "pnpm format:web && pnpm format:server",
        "format:web": "vp fmt --write .",
        "format:server": "mvn -f apps/server/pom.xml spotless:apply",
        "db:migrations:lint": "node scripts/db-migrations-lint.mjs",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "vp test run --fs-module-cache",
        "test:watch": "vp test --fs-module-cache",
        "test:related": "vp test related",
        "test:server": "node scripts/with-datastore.mjs && mvn -f apps/server/pom.xml test",
        "test:contract": "mvn -f apps/server/pom.xml test -q -Dgroups=contract",
        "test:e2e": "playwright test --config=e2e/playwright.config.ts",
        "i18n:gen": "node scripts/contracts/i18n-codegen.mjs",
        "i18n:drift": "node scripts/contracts/i18n-codegen.mjs --check",
        "errors:gen": "node scripts/contracts/error-codes-codegen.mjs --write",
        "errors:drift": "node scripts/contracts/error-codes-codegen.mjs --check",
        "permissions:gen": "node scripts/contracts/permissions-codegen.mjs --write",
        "permissions:drift": "node scripts/contracts/permissions-codegen.mjs --check",
        "sdk:gen": "curl -sf -m 10 http://localhost:8080/v3/api-docs -o openapi/api-docs.json && pnpm --filter @shop/api exec openapi-ts && pnpm sdk:audit",
        "sdk:drift": "node scripts/contracts/sdk-drift.mjs",
        "shape:drift": "node scripts/contracts/shape-drift.mjs",
        "routing:drift": "node scripts/contracts/routing-drift.mjs",
        "commands:drift": "node scripts/commands-drift.mjs",
        "z-index:guard": "node scripts/design/z-index-guard.mjs",
        "token:guard": "node scripts/design/token-guard.mjs",
        "perf": "vp run lighthouse",
        "perf:bundle": "vp run bundle-budget",
        "perf:bundle:check": "size-limit --config perf/size-limit.json",
        "perf:attrib": "node perf/analyze.mjs",
        "perf:cls": "node perf/cls.mjs",
        "fallow": "fallow dead-code",
        "fallow:audit": "fallow audit --brief",
        "sdk:audit": "node scripts/contracts/sdk-audit.mjs",
        "test:e2e:i18n": "playwright test --config e2e/i18n.config.ts",
        "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
        "perf:run": "playwright test --config=e2e/perf.config.ts"
    },
    "devDependencies": {
        "@axe-core/playwright": "catalog:",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@commitlint/types": "^21.2.3",
        "@lhci/cli": "catalog:",
        "@playwright/test": "^1.64.0",
        "@shadcn/lint": "^0.2.0",
        "@shop/config": "workspace:*",
        "@size-limit/file": "catalog:",
        "@tanstack/eslint-plugin-query": "^5.104.1",
        "@tanstack/eslint-plugin-router": "^1.162.0",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "concurrently": "^10.0.5",
        "consola": "catalog:",
        "eslint-import-resolver-typescript": "catalog:",
        "eslint-plugin-boundaries": "catalog:",
        "fallow": "3.31.0",
        "intl-messageformat": "catalog:",
        "lefthook": "^2.2.0",
        "oxlint-plugin-react-doctor": "0.9.14",
        "size-limit": "catalog:",
        "squawk-cli": "catalog:",
        "typescript": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "yaml": "catalog:",
        "zod": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.11.2",
            "onFail": "download"
        }
    },
    "sherif": {
        "failOnWarnings": true
    }
}
