{
    "name": "shop",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "type": "module",
    "scripts": {
        "dev": "concurrently -n web,server -c cyan,green \"pnpm dev:web\" \"pnpm dev:server\"",
        "dev:web": "pnpm --filter web dev",
        "dev:admin": "pnpm --filter admin dev",
        "dev:seller": "pnpm --filter seller dev",
        "dev:server": "concurrently -k -s first -n db,srv -c yellow,green \"node scripts/ensure-datastore.mjs --hold\" \"mvn -f apps/server/pom.xml spring-boot:run\"",
        "db:up": "node scripts/ensure-datastore.mjs",
        "db:down": "node scripts/ensure-datastore.mjs --down",
        "guard:install": "node scripts/tunnel-guard-task.mjs install",
        "guard:uninstall": "node scripts/tunnel-guard-task.mjs uninstall",
        "guard:status": "node scripts/tunnel-guard-task.mjs status",
        "guard:run": "node scripts/tunnel-guard-task.mjs run",
        "obs:dev": "node scripts/obs-stack.mjs dev",
        "obs:up": "node scripts/obs-stack.mjs up",
        "obs:down": "node scripts/obs-stack.mjs down",
        "obs:status": "node scripts/obs-stack.mjs status",
        "obs:cloud:sync": "node scripts/obs-cloud-sync.mjs",
        "health:scan": "node scripts/ops-health-scan.mjs",
        "secret:scan": "node scripts/secret-scan.mjs",
        "seed:demo": "node scripts/seed-demo.mjs",
        "build": "pnpm build:web && pnpm build:server",
        "build:web": "pnpm --filter web build",
        "build:admin": "pnpm --filter admin build",
        "build:seller": "pnpm --filter seller build",
        "build:server": "mvn -f apps/server/pom.xml compile",
        "package:server": "mvn -f apps/server/pom.xml -DskipTests package",
        "lint": "pnpm lint:web && pnpm lint:server",
        "lint:web": "vp lint --type-aware .",
        "lint:web:fix": "vp lint --type-aware --fix . && pnpm typecheck",
        "lint:server": "mvn -f apps/server/pom.xml compile",
        "format": "pnpm format:web && pnpm format:server",
        "format:web": "vp fmt --write .",
        "format:server": "mvn -f apps/server/pom.xml spotless:apply",
        "db:migrations:lint": "node scripts/db-migrations-lint.mjs",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "vp test run --fs-module-cache",
        "test:watch": "vp test --fs-module-cache",
        "test:project": "vp test run --fs-module-cache --project",
        "test:related": "vp test related",
        "test:changed": "vp test run --fs-module-cache --changed",
        "test:coverage": "vp test run --fs-module-cache --coverage --coverage.provider=v8 --coverage.reporter=json --coverage.reportsDirectory=.fallow-coverage",
        "test:server": "node scripts/with-datastore.mjs && mvn -f apps/server/pom.xml test",
        "test:e2e": "playwright test --config=e2e/playwright.config.ts",
        "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
        "i18n:gen": "node scripts/i18n-codegen.mjs",
        "i18n:drift": "node scripts/i18n-codegen.mjs --check",
        "errors:gen": "node scripts/error-codes-codegen.mjs --write",
        "errors:drift": "node scripts/error-codes-codegen.mjs --check",
        "sdk:gen": "curl -sf -m 10 http://localhost:8080/v3/api-docs -o openapi/api-docs.json && pnpm --filter @shop/api exec openapi-ts && pnpm contract:audit",
        "sdk:drift": "node scripts/check-sdk-drift.mjs",
        "types:drift": "node scripts/contract-shape-drift.mjs",
        "z-index:guard": "node scripts/z-index-guard.mjs",
        "perf": "vp run lighthouse",
        "perf:bundle": "vp run bundle-budget",
        "perf:bundle:check": "size-limit --config perf/size-limit.json",
        "perf:attrib": "node scripts/perf-analyze.mjs",
        "perf:cls": "node scripts/perf-cls.mjs",
        "fallow": "fallow dead-code",
        "fallow:production": "fallow dead-code --production",
        "fallow:audit": "fallow audit --brief",
        "fallow:health": "fallow health --coverage .fallow-coverage/coverage-final.json",
        "contract:audit": "node scripts/contract-audit.mjs",
        "test:e2e:i18n": "playwright test --config e2e/i18n.config.ts",
        "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
        "perf:run": "playwright test --config=e2e/perf.config.ts"
    },
    "devDependencies": {
        "@axe-core/playwright": "catalog:",
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@commitlint/types": "^21.2.3",
        "@lhci/cli": "catalog:",
        "@playwright/test": "^1.64.0",
        "@shadcn/lint": "^0.2.0",
        "@shop/config": "workspace:*",
        "@size-limit/file": "catalog:",
        "@tanstack/eslint-plugin-query": "^5.104.1",
        "@tanstack/eslint-plugin-router": "^1.162.0",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "chrome-launcher": "^1.2.2",
        "concurrently": "^10.0.5",
        "eslint-import-resolver-typescript": "catalog:",
        "eslint-plugin-boundaries": "catalog:",
        "fallow": "3.31.0",
        "intl-messageformat": "catalog:",
        "lefthook": "^2.2.0",
        "oxlint-plugin-react-doctor": "0.9.14",
        "size-limit": "catalog:",
        "squawk-cli": "catalog:",
        "typescript": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "yaml": "catalog:",
        "zod": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.11.2",
            "onFail": "download"
        }
    },
    "sherif": {
        "failOnWarnings": true
    }
}
