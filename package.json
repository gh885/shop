{
    "name": "shop",
    "version": "1.0.0",
    "private": true,
    "description": "多商家货架型平台电商（Marketplace）：Spring Modulith 模块化单体后端 + TanStack Start 三端前端",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "type": "module",
    "scripts": {
        "dev": "concurrently -n web,server -c cyan,green \"pnpm --filter web dev\" \"pnpm dev:server\"",
        "dev:server": "mvn -f apps/server/pom.xml spring-boot:run",
        "db:up": "docker compose -f compose.dev.yml up -d",
        "db:down": "docker compose -f compose.dev.yml down",
        "obs": "docker compose -f compose.dev.yml --profile obs up -d",
        "secret:scan": "node scripts/secret-scan.mjs",
        "build": "pnpm --filter web build && pnpm build:server",
        "build:server": "mvn -f apps/server/pom.xml compile",
        "lint": "pnpm lint:web && pnpm build:server",
        "lint:web": "vp lint --type-aware .",
        "lint:web:fix": "vp lint --type-aware --fix . && pnpm typecheck",
        "format": "pnpm format:web && pnpm format:server",
        "format:web": "vp fmt --write .",
        "format:server": "mvn -f apps/server/pom.xml spotless:apply",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "vp test run --fs-module-cache",
        "test:watch": "vp test --fs-module-cache",
        "test:related": "vp test related",
        "test:server": "mvn -f apps/server/pom.xml test",
        "test:boundaries": "mvn -f apps/server/pom.xml -q -Dtest=ModularityTest,ArchitectureTest,DataScopeTest test",
        "telemetry:build": "mvn -q -f telemetry/pom.xml package",
        "telemetry:test": "mvn -f telemetry/pom.xml test",
        "modules:check": "node scripts/check-module-graph.mjs",
        "test:e2e": "playwright test --config=e2e/playwright.config.ts",
        "i18n:gen": "node scripts/contracts/i18n-codegen.mjs",
        "i18n:drift": "node scripts/contracts/i18n-codegen.mjs --check",
        "permissions:gen": "node scripts/contracts/permissions-codegen.mjs",
        "permissions:drift": "node scripts/contracts/permissions-codegen.mjs --check",
        "commands:drift": "node scripts/commands-drift.mjs",
        "z-index:guard": "node scripts/design/z-index-guard.mjs",
        "token:guard": "node scripts/design/token-guard.mjs",
        "perf": "vp run lighthouse",
        "perf:bundle": "vp run bundle-budget",
        "perf:bundle:check": "size-limit --config perf/size-limit.json",
        "perf:attrib": "node perf/analyze.mjs",
        "perf:cls": "node perf/cls.mjs",
        "fallow": "fallow dead-code",
        "fallow:audit": "fallow audit --brief",
        "test:e2e:i18n": "playwright test --config e2e/i18n.config.ts",
        "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
        "perf:run": "playwright test --config=e2e/perf.config.ts"
    },
    "devDependencies": {
        "@axe-core/playwright": "catalog:",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@commitlint/types": "^21.2.3",
        "@lhci/cli": "catalog:",
        "@playwright/test": "^1.64.1",
        "@shadcn/lint": "^0.2.3",
        "@shop/config": "workspace:*",
        "@size-limit/file": "catalog:",
        "@tanstack/eslint-plugin-query": "^5.105.0",
        "@tanstack/eslint-plugin-router": "^1.162.0",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "concurrently": "^10.0.6",
        "consola": "catalog:",
        "eslint-import-resolver-typescript": "catalog:",
        "eslint-plugin-boundaries": "catalog:",
        "fallow": "catalog:",
        "intl-messageformat": "catalog:",
        "lefthook": "^2.2.2",
        "oxlint-plugin-react-doctor": "0.9.14",
        "size-limit": "catalog:",
        "squawk-cli": "catalog:",
        "typescript": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "yaml": "catalog:",
        "zod": "catalog:"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.11.2",
            "onFail": "download"
        }
    },
    "sherif": {
        "failOnWarnings": true
    }
}
