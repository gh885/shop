{
    "name": "shop",
    "version": "1.0.0",
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "type": "module",
    "scripts": {
        "dev": "concurrently -n web,server -c cyan,green \"pnpm dev:web\" \"pnpm dev:server\"",
        "dev:web": "pnpm --filter web dev",
        "dev:admin": "pnpm --filter admin dev",
        "dev:seller": "pnpm --filter seller dev",
        "dev:server": "concurrently -k -s first -n db,srv -c yellow,green \"node scripts/ensure-datastore.mjs --hold\" \"mvn -f apps/server/pom.xml spring-boot:run\"",
        "db:up": "node scripts/ensure-datastore.mjs",
        "db:down": "node scripts/ensure-datastore.mjs --down",
        "seed:demo": "node scripts/seed-demo.mjs",
        "build": "pnpm build:web && pnpm build:server",
        "build:web": "pnpm --filter web build",
        "build:admin": "pnpm --filter admin build",
        "build:seller": "pnpm --filter seller build",
        "build:server": "mvn -f apps/server/pom.xml compile",
        "lint": "pnpm lint:web && pnpm lint:server",
        "lint:web": "oxlint --type-aware --config packages/config/oxlint.config.ts --fix .",
        "lint:server": "mvn -f apps/server/pom.xml compile",
        "format": "pnpm format:web && pnpm format:server",
        "format:web": "oxfmt --config packages/config/oxfmt.config.ts --write .",
        "format:server": "mvn -f apps/server/pom.xml spotless:apply",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "knip": "knip",
        "knip:production": "knip --production",
        "gen:sdk": "curl -sf -m 10 http://localhost:8080/v3/api-docs -o openapi/api-docs.json && pnpm --filter @shop/api exec openapi-ts && npm run contract:audit",
        "contract:audit": "node scripts/contract-audit.mjs"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@commitlint/types": "^21.2.3",
        "@shadcn/lint": "^0.1.1",
        "@tanstack/eslint-plugin-query": "^5.103.1",
        "@tanstack/eslint-plugin-router": "^1.162.0",
        "concurrently": "^10.0.5",
        "knip": "^6.37.0",
        "lefthook": "^2.1.14",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.83.0",
        "oxlint-plugin-react-doctor": "0.9.14",
        "oxlint-tsgolint": "^7.0.2002",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "devEngines": {}
}
